# Скопируй в .env и заполни. Файл .env в git НЕ попадает.

# Часовой пояс (список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Moscow

# Логин/пароль для MQTT-брокера. Их же вводишь в Home Assistant при подключении MQTT.
MQTT_USER=ha
MQTT_PASSWORD=поменяй_меня_на_нормальный_пароль

# Путь к Zigbee-координатору. Узнать: bash scripts/find-zigbee.sh
# Пример: /dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_xxxx-if00-port0
ZIGBEE_DEVICE=/dev/ttyUSB0

# Тип чипа координатора:
#   zstack  — Sonoff ZBDongle-P, CC2652P/CC2652RB, CC1352P
#   ember   — Sonoff ZBDongle-E, любой EFR32MG21 (SkyConnect, SMLIGHT SLZB-06M и т.п.)
#   deconz  — ConBee II / III
ZIGBEE_ADAPTER=zstack

# Порт веб-морды Zigbee2MQTT
Z2M_PORT=8080
